"""
SwarmEngine / AgentRuntime — no Qt dependency, could run headless.

Cancellation note: llama-cpp-python's streaming create_chat_completion()
is a *pull*-based Python generator — each `for chunk in stream` iteration
is what triggers the next llama_decode() step. That means checking a
stop_event and simply breaking out of the loop (rather than calling
next() again) is a real, immediate cancellation point, not a cosmetic
one — we just never ask llama.cpp to generate the next token.
"""

import os
import threading
import time
from typing import Callable, Optional

from config import MODEL_DIR, AGENT_CONFIGS
from .adapters import ADAPTERS, ModelAdapter

try:
    from llama_cpp import Llama
    LLAMA_AVAILABLE = True
except ImportError:
    LLAMA_AVAILABLE = False


class CancelledError(Exception):
    pass


class AgentRuntime:
    def __init__(self, key: str, cfg: dict):
        self.key = key
        self.cfg = cfg
        self.path = os.path.join(MODEL_DIR, cfg["file"])
        self.llm: Optional["Llama"] = None
        self.available = LLAMA_AVAILABLE and os.path.isfile(self.path)
        self.adapter: ModelAdapter = ADAPTERS.get(cfg.get("adapter", "ModelAdapter"), ModelAdapter)()
        self.calls = 0
        self.errors = 0
        self.last_tokens_per_sec = 0.0
        self._load_lock = threading.Lock()

    def load(self):
        if self.llm is not None or not self.available:
            return
        with self._load_lock:
            if self.llm is not None:
                return
            self.llm = Llama(
                model_path=self.path,
                n_ctx=self.cfg.get("n_ctx", 4096),
                n_threads=max(1, (os.cpu_count() or 4) - 1),
                n_gpu_layers=-1,
                verbose=False,
            )

    def generate(
        self,
        user_prompt: str,
        context: Optional[dict] = None,
        on_token: Optional[Callable[[str], None]] = None,
        stop_event: Optional[threading.Event] = None,
    ) -> str:
        if not self.available:
            raise RuntimeError(f"{self.key} model not available (missing file or llama-cpp-python)")
        self.load()
        self.calls += 1
        messages = self.adapter.build_messages(self.cfg["system_prompt"], user_prompt, context)

        t0 = time.time()
        text = ""
        n_tokens = 0
        try:
            stream = self.llm.create_chat_completion(
                messages=messages,
                temperature=self.cfg.get("temperature", 0.3),
                max_tokens=self.cfg.get("max_tokens", 512),
                stream=True,
            )
            for chunk in stream:
                if stop_event is not None and stop_event.is_set():
                    raise CancelledError(f"{self.key} generation cancelled")
                delta = chunk["choices"][0]["delta"].get("content", "")
                if delta:
                    text += delta
                    n_tokens += 1
                    if on_token:
                        on_token(delta)
        except CancelledError:
            raise
        except Exception:
            self.errors += 1
            raise
        elapsed = max(1e-6, time.time() - t0)
        self.last_tokens_per_sec = n_tokens / elapsed
        return text.strip()


class SwarmEngine:
    def __init__(self):
        self.agents = {key: AgentRuntime(key, AGENT_CONFIGS[key]) for key in AGENT_CONFIGS}

    def status_line(self) -> str:
        return " ".join(f"{k}={'online' if a.available else 'offline'}" for k, a in self.agents.items())

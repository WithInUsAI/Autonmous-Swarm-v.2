r"""
MissionWorker — the actual closed loop:

    ROUTER
      |
    REASONER --------------------+
      |                          |
    EXECUTOR                     |  (REVISE)
      |  wants a tool?           |
      v                          |
    SPECIALIST -> ToolRegistry   |
      |  observation             |
      v                          |
    CRITIC  ---- PASS ---------> DONE
       \___________REVISE________/
                (up to MAX_SWARM_CYCLES)
"""

import threading
import time
import traceback
from typing import Optional

from PyQt6.QtCore import QThread, pyqtSignal

from config import AGENT_CONFIGS, AGENT_ORDER, MAX_SWARM_CYCLES
from .engine import SwarmEngine, CancelledError
from .router import parse_route
from .tools import ToolRegistry
from .json_utils import extract_json

PULSE_COLORS = {
    "THINK": "#4fa3ff",
    "TOOL": "#f2a93b",
    "VERIFY": "#ff5c5c",
    "SUCCESS": "#2fd18f",
}


def _parse_verdict(text: str) -> str:
    """Returns 'PASS' or 'REVISE'. Prefers an explicit VERDICT: tag,
    falls back to a structured {"verdict": ...} JSON blob, and
    defaults to REVISE (the safe direction — keeps looping rather
    than silently accepting a bad result) if neither is present."""
    import re
    m = re.search(r"VERDICT:\s*(PASS|REVISE)", text, re.IGNORECASE)
    if m:
        return m.group(1).upper()
    data = extract_json(text)
    if data and str(data.get("verdict", "")).upper() in ("PASS", "REVISE"):
        return str(data["verdict"]).upper()
    return "REVISE"


class MissionWorker(QThread):
    agent_status = pyqtSignal(str, str)
    agent_stream = pyqtSignal(str, str)
    agent_result = pyqtSignal(str, str)
    connection_pulse = pyqtSignal(str, str, str)     # from_key, to_key, kind (THINK/TOOL/VERIFY/SUCCESS)
    tool_call = pyqtSignal(str, str)                 # tool_name, arguments (repr)
    tool_result = pyqtSignal(str, str, bool)          # tool_name, result_text, ok
    cycle_update = pyqtSignal(int, int)               # cycle, max_cycles
    telemetry = pyqtSignal(str, float)
    event = pyqtSignal(str)
    mission_finished = pyqtSignal(bool)

    def __init__(self, engine: SwarmEngine, tools: ToolRegistry, task: str, simulate: bool, parent=None):
        super().__init__(parent)
        self.engine = engine
        self.tools = tools
        self.task = task
        self.simulate = simulate
        self.stop_event = threading.Event()
        self._pause = False

    def stop(self):
        self.stop_event.set()

    def toggle_pause(self, paused: bool):
        self._pause = paused

    def _wait_if_paused(self):
        while self._pause and not self.stop_event.is_set():
            time.sleep(0.1)

    def _log(self, line: str):
        self.event.emit(line)

    def _run_agent(self, key: str, prompt: str, context: Optional[dict] = None) -> str:
        self.agent_status.emit(key, "THINKING")
        buf = {"text": ""}

        def on_token(tok):
            buf["text"] += tok
            self.agent_stream.emit(key, buf["text"])

        if self.simulate or not self.engine.agents[key].available:
            name = AGENT_CONFIGS[key]["name"]
            role = AGENT_CONFIGS[key]["role"]
            fake = f"[simulated {name} / {role}] re: '{prompt[:50]}...'"
            for i in range(0, len(fake), 4):
                if self.stop_event.is_set():
                    break
                self._wait_if_paused()
                on_token(fake[i:i + 4])
                time.sleep(0.005)
            text = buf["text"]
            self.telemetry.emit(key, 42.0)
        else:
            try:
                text = self.engine.agents[key].generate(
                    prompt, context=context, on_token=on_token, stop_event=self.stop_event
                )
                self.telemetry.emit(key, self.engine.agents[key].last_tokens_per_sec)
            except CancelledError:
                self.agent_status.emit(key, "IDLE")
                raise
            except Exception as e:
                self.agent_status.emit(key, "ERROR")
                self._log(f"ERROR  {key} → {e}")
                raise

        self.agent_result.emit(key, text)
        self.agent_status.emit(key, "DONE")
        return text

    def _fire(self, a: str, b: str, kind: str):
        self.connection_pulse.emit(a, b, kind)

    def run(self):
        try:
            self._mission()
        except CancelledError:
            self._log("Mission cancelled by operator.")
            self.mission_finished.emit(False)
        except Exception:
            last_line = traceback.format_exc(limit=1).strip().splitlines()[-1]
            self._log(f"MISSION FAILED — {last_line}")
            self.mission_finished.emit(False)
        finally:
            for key in AGENT_ORDER:
                self.agent_status.emit(key, "IDLE")

    def _mission(self):
        self._log(f"MISSION ACCEPTED: {self.task}")

        # ---- ROUTE ----
        self._fire("director", "router", "THINK")
        route_text = self._run_agent("router", self.task)
        decision = parse_route(route_text)
        self._log(
            f"ROUTER → {decision.route} (confidence={decision.confidence:.2f}"
            f"{', unparsed — defaulted' if not decision.parsed_ok else ''}) — {decision.reason}"
        )
        if self.stop_event.is_set():
            raise CancelledError("stopped after routing")

        if decision.route == "SIMPLE":
            self._log("MISSION COMPLETE (reflex path — no full swarm needed)")
            self._fire("router", "director", "SUCCESS")
            self.mission_finished.emit(True)
            return

        # ---- CLOSED LOOP: REASON -> EXECUTE -> (TOOL) -> VERIFY -> REVISE? ----
        feedback = ""
        tool_schema = self.tools.schema()

        for cycle in range(1, MAX_SWARM_CYCLES + 1):
            self.cycle_update.emit(cycle, MAX_SWARM_CYCLES)
            self._log(f"--- CYCLE {cycle}/{MAX_SWARM_CYCLES} ---")

            self._fire("router" if cycle == 1 else "critic", "reasoner", "THINK")
            reasoner_prompt = f"Mission: {self.task}"
            if feedback:
                reasoner_prompt += f"\n\nPrevious critic feedback to address:\n{feedback}"
            reasoner_prompt += "\n\nProduce a short numbered plan."
            plan = self._run_agent("reasoner", reasoner_prompt)
            if self.stop_event.is_set():
                raise CancelledError("stopped after reasoning")

            self._fire("reasoner", "executor", "THINK")
            execution = self._run_agent(
                "executor",
                f"Plan:\n{plan}\n\nExecute this plan. If you need a tool, request it.",
                context={"tool_schema": tool_schema},
            )
            if self.stop_event.is_set():
                raise CancelledError("stopped after execution")

            tool_request = self.engine.agents["executor"].adapter.parse_structured(execution)
            observation = ""
            if tool_request and "tool" in tool_request:
                self._fire("executor", "specialist", "TOOL")
                self._log(f"EXECUTOR requests tool: {tool_request.get('tool')}")
                structured_text = self._run_agent(
                    "specialist",
                    f"Executor wants to call: {tool_request}\n\nProduce validated arguments.",
                    context={"tool_schema": tool_schema, "requested_tool": tool_request.get("tool")},
                )
                call = self.engine.agents["specialist"].adapter.parse_structured(structured_text) or tool_request
                tool_name = call.get("tool", tool_request.get("tool"))
                arguments = call.get("arguments", {})

                self._fire("specialist", "director", "TOOL")
                self.tool_call.emit(tool_name, repr(arguments))
                self._log(f"TOOL CALL  {tool_name}({arguments})")

                result = self.tools.call(tool_name, arguments)
                self.tool_result.emit(tool_name, result.as_observation()[:500], result.ok)
                self._log(f"TOOL RESULT  ok={result.ok}  {result.as_observation()[:200]}")
                observation = result.as_observation()

            if self.stop_event.is_set():
                raise CancelledError("stopped after tool phase")

            self._fire("executor", "critic", "VERIFY")
            if tool_request:
                self._fire("specialist", "critic", "VERIFY")
            critic_prompt = f"Plan:\n{plan}\n\nExecution:\n{execution}"
            if observation:
                critic_prompt += f"\n\nTool observation:\n{observation}"
            critic_prompt += "\n\nVerify correctness and completeness."
            verdict_text = self._run_agent("critic", critic_prompt)
            verdict = _parse_verdict(verdict_text)
            self._log(f"CRITIC VERDICT: {verdict}")

            if verdict == "PASS":
                self._log(f"MISSION COMPLETE after {cycle} cycle(s)")
                for a, b in zip(AGENT_ORDER, AGENT_ORDER[1:]):
                    self._fire(a, b, "SUCCESS")
                self._fire("critic", "director", "SUCCESS")
                self.mission_finished.emit(True)
                return

            feedback = verdict_text
            self._fire("critic", "reasoner", "VERIFY")
            if self.stop_event.is_set():
                raise CancelledError("stopped after verification")
            self._wait_if_paused()

        self._log(f"MISSION ENDED — no PASS within {MAX_SWARM_CYCLES} cycles (open revisions remain)")
        self.mission_finished.emit(False)
